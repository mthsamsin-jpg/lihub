{
  "manifest_version": 3,
  "name": "Uso LicitaHub · Preenchimento de Propostas",
  "short_name": "LicitaHub",
  "version": "0.1.0",
  "description": "Preenche, com conferência item a item, os valores, marcas e modelos da proposta montada no Uso LicitaHub nos portais de licitação.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Uso LicitaHub",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://usolicitahub.com.br/*",
    "https://*.supabase.co/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
