# Copie este arquivo para ".env" e preencha. O ".env" NUNCA deve ir para o GitHub.

# --- Supabase (painel do projeto > Project Settings > API Keys) ---------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable). Pode ser a antiga "anon key".
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (secret). Pode ser a antiga "service_role key".
# Ela ignora as regras de segurança do banco: use SÓ no servidor, nunca no site.
SUPABASE_SECRET_KEY=

# --- Inteligência artificial (leitura de editais) ------------------------------
# Quem lê os editais: gemini (padrão, tem plano gratuito) ou claude (pago)
IA_PROVEDOR=gemini

# Gemini (Google): crie a chave grátis em https://aistudio.google.com (botão "Get API key")
GEMINI_API_KEY=
GEMINI_MODELO=gemini-4-hydrogen
# Profundidade do raciocínio: low | medium | high | xhigh | auto
GEMINI_PENSAMENTO=high
# gratuito: custo zero, MAS o Google pode usar o conteúdo enviado para melhorar os
#   produtos dele (com revisão humana). Não envie documentos com dados pessoais.
# pago: o Google não usa os dados. Ative antes de atender clientes.
GEMINI_PLANO=gratuito

# Claude (Anthropic), opcional: https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-sonnet-5-5
CLAUDE_ESFORCO=high

# --- Assinaturas (Mercado Pago: Pix, crédito e débito) --------------------------
# Mercado Pago > Suas integrações > (sua aplicação) > Credenciais.
# Comece com o Access Token de TESTE (TEST-...); em produção, o APP_USR-...
# É SÓ do servidor: nunca coloque no site.
MP_ACCESS_TOKEN=
# Suas integrações > Webhooks: URL https://SEU-SITE/mercadopago/webhook, eventos
# "Pagamentos" e "Planos e assinaturas". Copie a "Assinatura secreta" para cá.
MP_WEBHOOK_SECRET=
# Endereço do site (para onde o cliente volta depois de pagar). Na internet, use o
# endereço público (https://...).
SITE_URL=http://localhost:8787

# --- E-mails de cadastro e senha (para não cair no spam) -------------------------
# O Supabase envia pelo Resend com o domínio usolicitahub.com.br.
# Aplicar: npm run email:configurar -- --aplicar
# A mesma chave manda os alertas do Robô Turbo 2.0 por e-mail (precisa estar no Render).
RESEND_API_KEY=
# Token pessoal do Supabase: supabase.com/dashboard/account/tokens (só para o script acima)
SUPABASE_ACCESS_TOKEN=
EMAIL_REMETENTE=nao-responda@usolicitahub.com.br

# --- Robô Turbo 2.0: modo real ---------------------------------------------------
# Chave do cofre de credenciais dos portais (AES-256-GCM). 32 bytes em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GUARDE COM CUIDADO: se a chave mudar ou se perder, as credenciais salvas não abrem
# mais (é só salvar de novo). Use a MESMA chave no computador e no Render.
CREDENCIAIS_CHAVE=
# Sessões reais ao mesmo tempo (cada uma abre um navegador Chromium)
ROBO_REAL_MAX_SESSOES=3
# "permitir" só para mapear um portal novo (usa seletores não conferidos; nunca envia lance)
ROBO_SELETORES_NAO_VALIDADOS=
# "nao" abre o navegador visível (para mapear seletores no computador)
ROBO_REAL_HEADLESS=sim
# Caminho de um Chrome/Chromium já instalado (vazio = baixado por: npx playwright install chromium)
ROBO_REAL_CHROMIUM=

# --- Servidor (API de análise de editais) --------------------------------------
PORTA=8787
# Endereços do site que podem chamar a API (separados por vírgula)
CORS_ORIGENS=http://localhost:5500,http://127.0.0.1:5500
# Sincronização automática com o PNCP, em minutos (0 = desliga)
SYNC_INTERVALO_MIN=60
ANALISES_SIMULTANEAS=2
PDF_MAX_MB=20

# --- PNCP -----------------------------------------------------------------------
# Modalidades sincronizadas: 6 Pregão Eletrônico, 8 Dispensa, 4 Concorrência Eletrônica
# (outras: 5 Concorrência Presencial, 7 Pregão Presencial, 12 Credenciamento...)
PNCP_MODALIDADES=6,8,4,7,9,3,5,12,13,1
# Na carga completa, inclui licitações que encerram até hoje + N dias
PNCP_DIAS=60
# Consultas simultâneas ao PNCP. Deixe 1: com mais, ele recusa (HTTP 429).
PNCP_CONCORRENCIA=1
# Apaga do catálogo o que encerrou há mais de N dias e ninguém acompanha (0 = nunca)
LIMPAR_DIAS=90
# 1 = guarda o JSON original do PNCP (ocupa bem mais espaço no banco)
PNCP_GUARDAR_BRUTO=0

# --- Coletores próprios de licitações (src/services/collectors) ----------------
# Liga a coleta agendada por cron. Ligado, substitui o SYNC_INTERVALO_MIN (não coleta em dobro).
ENABLE_SCRAPER_CRON=false
# Cron de 5 campos no horário de Brasília (padrão: de hora em hora, no minuto 10)
SCRAPER_CRON_SCHEDULE=10 * * * *
# Estados coletados (vazio = Brasil todo). Ex.: SP,MG,PR
SCRAPER_TARGET_UFS=
# Fontes ativas (hoje: pncp)
SCRAPER_FONTES=pncp
# publicacao | atualizacao (pega retificações) | abertas
SCRAPER_MODO=atualizacao
# Janela: de hoje - N dias até hoje
SCRAPER_DIAS_ATRAS=1
SCRAPER_MAX_PAGINAS=400
# Linhas por upsert no Supabase
SCRAPER_LOTE=50
# Dias de histórico mantidos em sync_execucoes (as licitações seguem LIMPAR_DIAS)
SCRAPER_HISTORICO_DIAS=60
# 1 = guarda o JSON bruto (só se for pequeno). Padrão 0: economiza espaço no banco.
SCRAPER_GUARDAR_BRUTO=0
# Token do disparo manual: POST /api/admin/coleta com "Authorization: Bearer <token>". Vazio = desligado.
SCRAPER_ADMIN_TOKEN=
# json (padrão, bom para o Render) ou texto
LOG_FORMATO=json

# --- Inteligência de mercado: coleta retroativa direcionada (Fase 3) ------------
# 0 desliga. Busca compras encerradas dos termos dos radares ativos (+ MERCADO_RETRO_TERMOS)
MERCADO_RETRO=1
# Horário (Brasília) em que roda: de madrugada, para não disputar o PNCP com o dia
MERCADO_RETRO_HORAS=0-6
MERCADO_RETRO_MESES=12
# Termos extras, separados por vírgula (ex.: papel a4,toner,notebook)
MERCADO_RETRO_TERMOS=
# Trava de espaço: não cresce a base se o banco passar disto (plano gratuito = 500 MB)
MERCADO_LIMITE_MB=400
