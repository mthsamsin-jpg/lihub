# Copie este arquivo para ".env" e preencha. O ".env" NUNCA deve ir para o GitHub.

# --- Supabase (painel do projeto > Project Settings > API Keys) ---------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable). Pode ser a antiga "anon key".
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (secret). Pode ser a antiga "service_role key".
# Ela ignora as regras de segurança do banco: use SÓ no servidor, nunca no site.
SUPABASE_SECRET_KEY=

# --- Inteligência artificial (leitura de editais) ------------------------------
# Quem lê os editais: gemini (padrão, tem plano gratuito) ou claude (pago)
IA_PROVEDOR=gemini

# Gemini (Google): crie a chave grátis em https://aistudio.google.com (botão "Get API key")
GEMINI_API_KEY=
GEMINI_MODELO=gemini-4-hydrogen
# Profundidade do raciocínio: low | medium | high | xhigh | auto
GEMINI_PENSAMENTO=high
# gratuito: custo zero, MAS o Google pode usar o conteúdo enviado para melhorar os
#   produtos dele (com revisão humana). Não envie documentos com dados pessoais.
# pago: o Google não usa os dados. Ative antes de atender clientes.
GEMINI_PLANO=gratuito

# Claude (Anthropic), opcional: https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-sonnet-5-5
CLAUDE_ESFORCO=high

# --- Assinaturas (Stripe) ---------------------------------------------------------
# Painel da Stripe > Desenvolvedores > Chaves de API. Comece com a de TESTE (sk_test_...).
# A chave secreta é SÓ do servidor: nunca coloque no site.
STRIPE_SECRET_KEY=
# Chave publicável (pk_...): pode ir no site. Ainda não é usada (o pagamento é na página da Stripe).
STRIPE_PUBLISHABLE_KEY=
# Segredo dos avisos da Stripe (whsec_...): Desenvolvedores > Webhooks, ou o "stripe listen"
STRIPE_WEBHOOK_SECRET=
# Endereço do site (para onde o cliente volta depois de pagar). O servidor entrega
# o site no mesmo endereço da API; na internet, use o endereço público (https://...).
SITE_URL=http://localhost:8787
# Dias de teste grátis nos planos pagos (0 = sem teste). Uma vez por organização.
STRIPE_DIAS_TESTE=7
# Formas de pagamento no checkout, separadas por vírgula (ex.: card,boleto).
# Vazio = as que estiverem ativadas no painel da Stripe.
STRIPE_FORMAS_PAGAMENTO=

# --- Servidor (API de análise de editais) --------------------------------------
PORTA=8787
# Endereços do site que podem chamar a API (separados por vírgula)
CORS_ORIGENS=http://localhost:5500,http://127.0.0.1:5500
# Sincronização automática com o PNCP, em minutos (0 = desliga)
SYNC_INTERVALO_MIN=60
ANALISES_SIMULTANEAS=2
PDF_MAX_MB=20

# --- PNCP -----------------------------------------------------------------------
# Modalidades sincronizadas: 6 Pregão Eletrônico, 8 Dispensa, 4 Concorrência Eletrônica
# (outras: 5 Concorrência Presencial, 7 Pregão Presencial, 12 Credenciamento...)
PNCP_MODALIDADES=6,8,4
# Na carga completa, inclui licitações que encerram até hoje + N dias
PNCP_DIAS=60
# Consultas simultâneas ao PNCP. Deixe 1: com mais, ele recusa (HTTP 429).
PNCP_CONCORRENCIA=1
# Apaga do catálogo o que encerrou há mais de N dias e ninguém acompanha (0 = nunca)
LIMPAR_DIAS=90
# 1 = guarda o JSON original do PNCP (ocupa bem mais espaço no banco)
PNCP_GUARDAR_BRUTO=0
